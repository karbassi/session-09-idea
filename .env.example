# Email Service Configuration (choose one)
# Option 1: EmailJS
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_BOOKING_CONFIRMATION=your_template_id
EMAILJS_TEMPLATE_DEPOSIT_INSTRUCTIONS=your_template_id
EMAILJS_TEMPLATE_APPOINTMENT_REMINDER=your_template_id
EMAILJS_TEMPLATE_NEW_BOOKING_ADMIN=your_template_id
EMAILJS_PUBLIC_KEY=your_public_key

# Option 2: SendGrid
SENDGRID_API_KEY=your_api_key
SENDGRID_FROM_EMAIL=your_verified_sender@example.com

# SMS Service Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Admin Notification Settings
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+1234567890

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
